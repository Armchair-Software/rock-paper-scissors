<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="client" />
		<Option makefile="(build script)" />
		<Option makefile_is_custom="1" />
		<Option compiler="gcc" />
		<Option virtualFolders="CMake Files/;" />
		<Build>
			<Target title="client">
				<Option output="run.sh" prefix_auto="0" extension_auto="0" />
				<Option working_dir="./" />
				<Option object_output="obj/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option use_console_runner="0" />
				<MakeCommands>
					<Build command="./build.sh client" />
					<CompileFile command='./build.sh &quot;$file&quot;' />
					<Clean command="./build.sh clean" />
					<DistClean command="./build.sh clean" />
					<AskRebuildNeeded command="$make -q -f build/Makefile $target" />
					<SilentBuild command="./build.sh client &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
		</Build>
		<Unit filename="CMakeLists.txt">
			<Option virtualFolder="CMake Files/" />
		</Unit>
		<Unit filename="build.sh" />
		<Unit filename="compile_resource_to_raw_string.sh" />
		<Unit filename="game_logic/difficulty.h" />
		<Unit filename="game_logic/game_logic_base.cpp" />
		<Unit filename="game_logic/game_logic_base.h" />
		<Unit filename="game_logic/move.cpp" />
		<Unit filename="game_logic/move.h" />
		<Unit filename="game_logic/offline.cpp" />
		<Unit filename="game_logic/offline.h" />
		<Unit filename="game_logic/strategy/random.cpp" />
		<Unit filename="game_logic/strategy/random.h" />
		<Unit filename="game_logic/strategy/strategy_base.h" />
		<Unit filename="game_logic/strategy/wang_et_al_2014.cpp" />
