		<Unit filename="game_logic/strategy/wang_et_al_2014_mod1.cpp" />
		<Unit filename="game_logic/strategy/wang_et_al_2014_mod1.h" />
		<Unit filename="game_state.h" />
		<Unit filename="generate_git_version.sh" />
		<Unit filename="get_version.cpp" />
		<Unit filename="get_version.h" />
		<Unit filename="git_version.h" />
		<Unit filename="gui/draw_stats_window.cpp" />
		<Unit filename="gui/draw_stats_window.h" />
		<Unit filename="gui/gui.cpp" />
		<Unit filename="gui/gui.h" />
